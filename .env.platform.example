APP_ENV=production
APP_NAME=Corporate LMS
WEB_ORIGIN=https://app.example.com
NEXT_PUBLIC_SITE_URL=https://app.example.com
API_ORIGIN=https://app.example.com/api
ALLOWED_HOSTS=app.example.com,api
DATABASE_URL=postgresql+asyncpg://lms_app:change-me@postgres:5432/corplms
REDIS_URL=redis://valkey:6379/0
SESSION_COOKIE_NAME=corp_lms_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=true
LOG_LEVEL=INFO
API_DOCS_ENABLED=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=mailer
SMTP_PASSWORD=change-me
SMTP_FROM=no-reply@example.com
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
DEV_EMAIL_SINK=false

FILE_STORAGE_ROOT=/var/lib/corplms/uploads
MAX_UPLOAD_BYTES=26214400
STORAGE_BACKEND=local
STORAGE_ROOT=/var/lib/corplms/uploads
MAX_UPLOAD_MB=25
FILE_SCAN_PROVIDER=clamd
FILE_SCAN_HOST=clamav
FILE_SCAN_PORT=3310
FILE_SCAN_TIMEOUT_SECONDS=30

RESET_TOKEN_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
SSO_STATE_KEY=replace-with-a-strong-fernet-key
SSO_TRANSACTION_TTL_SECONDS=600
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_ENCRYPTION_KEYS=replace-with-encryption-key-set
WEBHOOK_ACTIVE_KEY_ID=primary
INTEGRATION_ALLOW_PRIVATE_URLS=false

AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com
AI_MODEL=
AI_AZURE_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SAAS_OPS_TENANT_SLUG=kalam
SAAS_OPS_TENANT_NAME=Kalam
SAAS_OPS_ADMIN_EMAIL=ops@example.com
SAAS_OPS_ADMIN_PASSWORD=change-me
MARKETING_INBOX_ENABLED=false
MARKETING_REVIEW_TENANT_SLUG=kalam

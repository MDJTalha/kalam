APP_ENV=development
APP_NAME=Corporate LMS API
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
REDIS_URL=redis://127.0.0.1:56379/7
WEB_ORIGIN=http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1
API_ORIGIN=http://127.0.0.1:8000
SESSION_COOKIE_NAME=corp_lms_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
LOG_LEVEL=INFO
API_DOCS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=15
DEV_EMAIL_SINK=true
RESET_TOKEN_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
STORAGE_BACKEND=local
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_MB=25
FILE_SCAN_PROVIDER=clamd
FILE_SCAN_HOST=127.0.0.1
FILE_SCAN_PORT=55000
FILE_SCAN_TIMEOUT_SECONDS=30
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_ENCRYPTION_KEYS=
WEBHOOK_ACTIVE_KEY_ID=primary

# AI remains disabled until an administrator registers a provider/model and
# enables a tenant governance policy. The secret values are deployment-only.
AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com
AI_MODEL=
AI_AZURE_API_VERSION=2024-10-21
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Dedicated Kalam operator plane for CRM, commercial data and public marketing review.
# Run scripts/bootstrap_saas_ops.py before enabling these in a real environment.
SAAS_OPS_TENANT_SLUG=kalam
SAAS_OPS_TENANT_NAME=Kalam
SAAS_OPS_ADMIN_EMAIL=
SAAS_OPS_ADMIN_PASSWORD=
MARKETING_INBOX_ENABLED=false
MARKETING_REVIEW_TENANT_SLUG=kalam

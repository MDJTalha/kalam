{
  "name": "corporate-lms",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Corporate Learning Management System",
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck:web": "npm --workspace apps/web run typecheck",
    "validate:phase0": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/scripts/phase0-validate.ps1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "allowScripts": {}
}

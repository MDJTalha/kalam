APP_ENV=development
APP_NAME=Corporate LMS
WEB_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
API_ORIGIN=http://127.0.0.1:8000
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
REDIS_URL=redis://127.0.0.1:56379/7
SESSION_COOKIE_NAME=corp_lms_session
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
LOG_LEVEL=INFO
AI_ENABLED=false
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com
AI_MODEL=
AI_AZURE_API_VERSION=2024-10-21
# Provider credentials are injected only into the API service at deployment time.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FILE_STORAGE_ROOT=data/uploads
MAX_UPLOAD_BYTES=26214400
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
DEV_EMAIL_SINK=true
WEBHOOK_ENCRYPTION_KEYS=
WEBHOOK_ACTIVE_KEY_ID=primary
RESET_TOKEN_MINUTES=30
SSO_STATE_KEY=replace-with-fernet-key
SSO_TRANSACTION_TTL_SECONDS=600
